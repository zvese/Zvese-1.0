# =============================================================================
# Zvese 1.0 — Environment Variables
# Copy this file to .env.local and fill in your Supabase project credentials.
# Get values from: https://supabase.com/dashboard/project/_/settings/api
# =============================================================================

# Supabase (required for auth, database, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role — server-side only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# App URL (used for auth redirects; set to your Vercel domain in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email (server-side only; use a verified Resend sender)
RESEND_API_KEY=
ZVESE_EMAIL_FROM=
